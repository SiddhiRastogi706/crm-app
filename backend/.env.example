# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulse_crm?schema=public

# Authentication & JWT
JWT_ACCESS_SECRET=super_secret_jwt_access_key_pulse_crm_2026_secure
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_pulse_crm_2026_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (optional, fallback to in-memory)
REDIS_URL=redis://localhost:6379

# Email / SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_user
SMTP_PASS=test_pass
EMAIL_FROM="Pulse CRM <no-reply@pulsecrm.com>"

# Security & Rate Limiting
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX_REQUESTS=20
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINS=15
